# ============================================================
# Backend environment variables
# Copy to .env and fill in real values:  cp .env.example .env
# (LLM/GROQ keys live in ai-agents/.env — see ai-agents/.env.example)
# ============================================================

# ---- Server ----
PORT=4000                       # Express port
NODE_ENV=development            # "production" disables POST /api/dev/simulate-message

# ---- Database & Queue ----
MONGO_URI=mongodb://localhost:27017/whatsapp_ai
REDIS_URL=redis://localhost:6379

# ---- WhatsApp mock sender ----
WHATSAPP_MODE=mock              # "mock" = save reply to sentmessages instead of calling Meta API

# ---- Auth (JWT) ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- AI worker ----
AGENT_URL=http://127.0.0.1:8000/reply   # Python LangGraph agent endpoint
AGENT_TIMEOUT_MS=45000                   # worker -> agent HTTP timeout (agent has its own 20s LLM timeout)
WORKER_CONCURRENCY=10                    # parallel jobs across different leads (per-lead order is separate)
DEBOUNCE_MS=3000                         # trailing debounce: N messages in 3s = 1 job = 1 LLM call
HISTORY_BATCH=10                         # max unreplied inbound messages merged per reply
FALLBACK_TEXT=Thanks for your message! Our team will get back to you shortly.   # saved with sender="fallback"

# ---- Simulation script (scripts/simulate.js) ----
WEBHOOK_URL=http://localhost:4000/webhook/whatsapp
